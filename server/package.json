{
  "name": "server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:init": "tsx --env-file-if-exists=.env src/scripts/init-db.ts",
    "user:create": "tsx --env-file-if-exists=.env src/scripts/create-user.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
